{
  "name": "doubleshot-monorepo",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "A solution to save effort",
  "author": "ArcherGu (https://github.com/ArcherGu/)",
  "keywords": [
    "electron",
    "vite",
    "nestjs"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "test": "npm run build && npm run test-only",
    "test-only": "pnpm exec install-electron && vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "release": "mor",
    "ci-publish": "mor publish -u pnpm",
    "postinstall": "npx simple-git-hooks"
  },
  "devDependencies": {
    "@esm2cjs/execa": "6.1.1-cjs.1",
    "@lightwing/eslint-config": "1.0.159",
    "@nestjs/testing": "12.0.1",
    "@types/fs-extra": "11.0.4",
    "@types/node": "26.4.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "conventional-changelog-cli": "5.0.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "eslint": "10.9.1",
    "fs-extra": "11.4.0",
    "lint-staged": "17.4.1",
    "mono-release": "2.10.4",
    "rimraf": "6.1.3",
    "simple-git-hooks": "2.14.0",
    "tsdown": "0.23.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{js,ts,tsx,vue,md,json,yml}": [
      "eslint --fix"
    ]
  }
}
